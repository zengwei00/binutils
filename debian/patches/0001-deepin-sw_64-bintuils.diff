+/* print token expression with sw_64 specific extension.  */
+
+static void
+sw_64_print_token (FILE *f, const expressionS *exp)
+{
+  switch (exp->X_op)
+    {
+    case O_cpregister:
+      putc (',', f);
+      /* FALLTHRU */
+    case O_pregister:
+      putc ('(', f);
+      {
+	expressionS nexp = *exp;
+	nexp.X_op = O_register;
+	print_expr_1 (f, &nexp);
+      }
+      putc (')', f);
+      break;
+    default:
+      print_expr_1 (f, exp);
+      break;
+    }
+}
+#endif
