+  {BFD_RELOC_SW_64_DTPREL64,		R_SW_64_DTPREL64},
+  {BFD_RELOC_SW_64_DTPREL_HI16,		R_SW_64_DTPRELHI},
+  {BFD_RELOC_SW_64_DTPREL_LO16,		R_SW_64_DTPRELLO},
