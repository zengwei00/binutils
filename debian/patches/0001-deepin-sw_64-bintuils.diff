+static const char *
+vms_time_to_str (unsigned char *buf)
+{
+  time_t t = vms_rawtime_to_time_t (buf);
+  char *res = ctime (&t);
+
+  if (!res)
+    res = "*invalid time*";
+  else
+    res[24] = 0;
+  return res;
+}
