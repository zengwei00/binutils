+  if (flags & EGSY__V_DEF)
+    fputs (_(" DEF"), file);
+  if (flags & EGSY__V_UNI)
+    fputs (_(" UNI"), file);
+  if (flags & EGSY__V_REL)
+    fputs (_(" REL"), file);
+  if (flags & EGSY__V_COMM)
+    fputs (_(" COMM"), file);
+  if (flags & EGSY__V_VECEP)
+    fputs (_(" VECEP"), file);
+  if (flags & EGSY__V_NORM)
+    fputs (_(" NORM"), file);
+  if (flags & EGSY__V_QUAD_VAL)
+    fputs (_(" QVAL"), file);
+}
