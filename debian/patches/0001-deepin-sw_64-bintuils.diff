+static void
+s_sw_64_coff_wrapper (int which)
+{
+  static void (* const fns[]) (int) = {
+    ecoff_directive_begin,
+    ecoff_directive_bend,
+    ecoff_directive_def,
+    ecoff_directive_dim,
+    ecoff_directive_endef,
+    ecoff_directive_scl,
+    ecoff_directive_tag,
+    ecoff_directive_val,
+  };
